<?xml version="1.0" encoding="utf-8"?>
<!--
  행 광고 템플릿: [아이콘] [배지 + 제목 / 본문] [CTA 칩]. 큰 미디어는 두지 않는다(동영상 광고는 그리지 않는다).
  크기·색·여백은 NativeAdRowStyle 로 코드가 채운다. 등록 자산은 아이콘·제목·본문·CTA 뿐이라 배지·배경은 클릭 영역이 아니다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/net_plumt_ads_row_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/net_plumt_ads_row_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/net_plumt_ads_row_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/net_plumt_ads_row_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/net_plumt_ads_row_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/net_plumt_ads_row_cta"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textStyle="bold" />
</LinearLayout>
